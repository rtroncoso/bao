.env
.env*

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated seed SQL (only .gitkeep is tracked)
seeds/*
!seeds/.gitkeep

# AO 13.0 legacy inputs (gitignored; only .gitkeep is tracked)
public/dats/*
!public/dats/.gitkeep
public/audio/*
!public/audio/.gitkeep
public/maps/*
!public/maps/.gitkeep
public/worlds/*
!public/worlds/.gitkeep