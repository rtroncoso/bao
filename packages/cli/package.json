{
  "name": "@bao/cli",
  "version": "0.1.0",
  "description": "Bao asset tooling CLI — map conversion, world seeding, S3 deploy",
  "type": "module",
  "private": true,
  "main": "./dist/cli.js",
  "bin": {
    "bao": "./bin/bao.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtroncoso/bao.git",
    "directory": "packages/cli"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "prettier:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@bao/core": "workspace:*",
    "@bao/env": "workspace:*",
    "cli-progress": "^3.8.2",
    "commander": "^6.0.0",
    "dotenv": "^16.0.3",
    "mysql2": "^3.11.0",
    "pixi.js": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
