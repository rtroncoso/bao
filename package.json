{
  "name": "bao",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "lint": "turbo run lint",
    "test": "cross-env NODE_ENV=testing turbo run test",
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev --filter=@bao/api --filter=@bao/client --filter=@bao/server --filter=@bao/core",
    "dev:db": "docker compose up -d mysql",
    "format": "turbo run prettier"
  },
  "devDependencies": {
    "cross-env": "^7.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0"
}
