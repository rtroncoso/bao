# Copy to .env at the repo root and adjust for your environment.

# --- Shared secrets ---
JWT_SECRET=change-me

# --- MySQL (API) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bao

# --- Service ports ---
API_PORT=9000
SERVER_PORT=7666
CLIENT_PORT=3000

# --- Service URLs (override ports when deploying behind proxies) ---
API_BASE_URL=http://localhost:9000
CLIENT_API_URL=http://localhost:9000/client
CLIENT_SERVER_URL=ws://localhost:7666
CLIENT_ASSETS_URL=https://bao-assets.rtroncoso.com

# --- Optional ---
LOG_LEVEL=info

# --- Assets deploy (packages/assets) — use .env.staging / .env.production ---
# AWS_S3_BUCKET=
# AWS_S3_ACCESS_KEY=
# AWS_S3_SECRET_KEY=
# AWS_S3_REGION=
