# Copy to .env at the repo root and adjust for your environment.
# Local MySQL: pnpm dev:db  (then pnpm dev)
# @bao/env and @bao/types are built automatically before dev (not watched).

# --- Shared secrets ---
JWT_SECRET=change-me

# --- MySQL (API) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bao

# --- Service ports ---
API_PORT=9000
SERVER_PORT=7666
PORT=3000

# --- Backend URLs (API, Colyseus) ---
API_BASE_URL=http://localhost:9000

# Comma-separated browser origins allowed to connect to Colyseus (set on VPS).
# Example: https://your-app.vercel.app,https://www.your-domain.com
# CORS_ORIGINS=

# --- Client (Next.js / Vercel — exposed to the browser) ---
NEXT_PUBLIC_BAO_API=http://localhost:9000/client
NEXT_PUBLIC_BAO_SERVER=ws://localhost:7666
NEXT_PUBLIC_BAO_ASSETS=https://bao-assets.rtroncoso.com

# --- Optional ---
LOG_LEVEL=info

# --- Assets deploy (packages/assets) — use .env.staging / .env.production ---
# AWS_S3_BUCKET=
# AWS_S3_ACCESS_KEY=
# AWS_S3_SECRET_KEY=
# AWS_S3_REGION=
